// The chord sheet (F-ED-1, F-ED-2, F-ED-8): a paper chart, black ink on white, boxed rehearsal marks for sections.
// Sizes follow grid.css, Size.rem = 16px.

import { Palette } from "std-widgets.slint";
import "../fonts/PatrickHand-Regular.ttf";
import "../fonts/Kalam-Regular.ttf";
import "../fonts/Kalam-Bold.ttf";
import "../fonts/PetalumaScript.ttf";
import "../fonts/PetalumaText.ttf";
import "../fonts/DejaVuSerif.ttf";
import "../fonts/DejaVuSerif-Bold.ttf";

export struct SlotView {
    text: string,
    /// What a screen reader says: section, bar, beat and the chord spelled out.
    spoken: string,
    beats: int,
    low-confidence: bool,
}

export struct BarView {
    /// A per-bar meter override ("2/4"), or empty.
    meter: string,
    slots: [SlotView],
}

export struct RowView {
    bars: [BarView],
}

export struct SectionView {
    label: string,
    bar-count: int,
    /// Shown as "x2" above 1.
    repeat: int,
    rows: [RowView],
}

export struct ChartView {
    title: string,
    artist: string,
    /// The key as displayed ("F#m"), or empty.
    key: string,
    /// "♩ = 120", or empty.
    tempo: string,
    bars-per-row: int,
    sections: [SectionView],
}

// grid.css's rem: the browser's 16px, not the platform's default font size Slint's rem follows.
global Size {
    out property <length> rem: 16px;
}

// The chart font, and the stroke that thickens bold text in a font without a bold face, as browsers fake bold.
global ChartFont {
    in-out property <string> family;
    in-out property <bool> has-bold;
    out property <length> bold-stroke: has-bold ? 0 : 0.6px;
}

// The sheet's colours; a dark sheet one step lighter than the dark chrome, as grid.css.
global Ink {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> ink: dark ? #e6e6e6 : #000;
    out property <color> paper: dark ? #26262a : #fff;
    out property <color> muted: dark ? #a3a3a3 : #555;
    out property <color> hairline: dark ? #8a8a8a : #767676;
    out property <color> doubt: dark ? #fb923c : #a64200;
    out property <color> focus: dark ? #93c5fd : #1d4ed8;
    out property <color> editing: dark ? #4a3f12 : #fef9c3;
    out property <color> selection: dark ? #1e3a5f : #dbeafe;
}

/// A right-click menu item (editor.rs `MenuAction`).
export enum MenuChoice {
    split,
    add-bar-before,
    add-bar-after,
    remove-bar,
    split-section-before,
    split-section-after,
    add-bar-at,
    split-section-at,
    merge-with-previous,
}

/// The editor's state as the grid shows it, and what the grid reports back (editor.rs).
export global Grid {
    in property <int> cursor-section;
    in property <int> cursor-bar;
    in property <int> cursor-slot;
    /// Edit mode: right-click menus and the hover frame.
    in property <bool> is-editable;
    /// Keyboard focus is in the grid: the cursor slot gets its ring.
    in-out property <bool> has-focus;
    /// The inline input: none, a chord in the cursor slot, or the cursor section's name.
    in property <bool> is-drafting-chord;
    in property <bool> is-drafting-label;
    in property <string> draft-text;
    in property <bool> draft-select-all;
    in property <string> draft-error;
    /// The selected bars of a section, -1 for none.
    in property <int> selection-section: -1;
    in property <int> selection-from;
    in property <int> selection-to;
    callback slot-clicked(int, int, int);
    /// A right-click menu item on (section, bar, slot); a bar line's bar is the one after it.
    callback menu(MenuChoice, int, int, int);
    callback section-clicked(int);
    callback draft-edited(string);
    /// A key in the inline input; true when the editor took it.
    callback draft-key(KeyEvent) -> bool;
    callback draft-blurred();
    /// An inline input has the keyboard focus.
    in-out property <bool> draft-focused;
    /// The cursor slot's position in the sheet, to scroll it into view.
    callback reveal(length, length);
}

/// The inline input, focused and selected as the draft says when it appears.
component DraftInput inherits Rectangle {
    in property <length> font-size;
    background: Ink.editing;
    border-width: 3px;
    border-color: Ink.focus;
    input := TextInput {
        x: 0.5 * Size.rem;
        width: parent.width - Size.rem;
        text: Grid.draft-text;
        font-family: ChartFont.family;
        font-size: root.font-size;
        font-weight: 600;
        color: Ink.ink;
        vertical-alignment: center;
        single-line: true;
        accessible-label: Grid.is-drafting-label ? @tr("Section name") : @tr("Chord");
        init => {
            self.focus();
            if (Grid.draft-select-all) {
                self.select-all();
            } else {
                self.set-selection-offsets(self.text.character-count, self.text.character-count);
            }
        }
        edited => { Grid.draft-edited(self.text); }
        key-pressed(event) => { Grid.draft-key(event) ? EventResult.accept : EventResult.reject }
        changed has-focus => {
            Grid.draft-focused = self.has-focus;
            if (!self.has-focus) {
                Grid.draft-blurred();
            }
        }
    }
    if Grid.draft-error != "": Rectangle {
        x: 0;
        y: parent.height;
        width: error.preferred-width + Size.rem;
        height: error.preferred-height + 0.5 * Size.rem;
        background: Ink.paper;
        border-width: 1px;
        border-color: Ink.doubt;
        error := Text {
            text: Grid.draft-error;
            font-size: 0.9 * Size.rem;
            color: Ink.doubt;
            accessible-role: text;
        }
    }
}

/// A dotted line: `vertical` for the hairline between slots, else under a doubtful chord.
component Dots inherits Rectangle {
    in property <bool> vertical;
    in property <color> dot-color;
    in property <length> dot;
    in property <length> step: 2 * dot;
    for i in floor((vertical ? self.height : self.width) / step): Rectangle {
        x: vertical ? 0 : i * step;
        y: vertical ? i * step : 0;
        width: dot;
        height: dot;
        background: dot-color;
    }
}

component Slot inherits Rectangle {
    in property <SlotView> slot;
    in property <int> section;
    in property <int> bar;
    in property <int> index;
    in property <int> bar-count;
    out property <bool> is-cursor: Grid.cursor-section == section && Grid.cursor-bar == bar && Grid.cursor-slot == index;
    accessible-role: text;
    accessible-label: slot.spoken;
    changed is-cursor => {
        if (self.is-cursor) {
            Grid.reveal(self.absolute-position.y, self.height);
        }
    }
    // A left click edits the slot; above it, the menu area only takes right-clicks.
    TouchArea {
        clicked => { Grid.slot-clicked(section, bar, index); }
    }
    ContextMenuArea {
        enabled: Grid.is-editable;
        Menu {
            MenuItem {
                title: @tr("Split");
                enabled: slot.beats > 1;
                activated => { Grid.menu(MenuChoice.split, section, bar, index); }
            }
            MenuItem {
                title: @tr("Add empty bar before");
                activated => { Grid.menu(MenuChoice.add-bar-before, section, bar, index); }
            }
            MenuItem {
                title: @tr("Add empty bar after");
                activated => { Grid.menu(MenuChoice.add-bar-after, section, bar, index); }
            }
            MenuItem {
                title: @tr("Remove bar");
                activated => { Grid.menu(MenuChoice.remove-bar, section, bar, index); }
            }
            MenuItem {
                title: @tr("Split section before this bar");
                enabled: bar > 0;
                activated => { Grid.menu(MenuChoice.split-section-before, section, bar, index); }
            }
            MenuItem {
                title: @tr("Split section after this bar");
                enabled: bar < bar-count - 1;
                activated => { Grid.menu(MenuChoice.split-section-after, section, bar, index); }
            }
        }
    }
    label := Text {
        x: 0.5 * Size.rem;
        width: parent.width - Size.rem;
        text: slot.text;
        font-family: ChartFont.family;
        font-size: 1.4 * Size.rem;
        font-weight: 600;
        stroke: self.color;
        stroke-width: ChartFont.bold-stroke;
        color: slot.low-confidence ? Ink.doubt : Ink.ink;
        vertical-alignment: center;
        overflow: elide;
    }
    if is-cursor && Grid.has-focus && !Grid.is-drafting-chord: Rectangle {
        border-width: 3px;
        border-color: Ink.focus;
    }
    if is-cursor && Grid.is-drafting-chord: DraftInput {
        font-size: 1.4 * Size.rem;
    }
    if slot.low-confidence && !(is-cursor && Grid.is-drafting-chord): Dots {
        x: label.x;
        y: label.y + label.height / 2 + 0.8 * Size.rem;
        width: min(label.preferred-width, label.width);
        height: 2px;
        dot: 2px;
        dot-color: Ink.doubt;
    }
}

component Bar inherits Rectangle {
    in property <BarView> bar;
    in property <int> section;
    in property <int> index;
    in property <int> bar-count;
    min-height: 3 * Size.rem;
    background: Grid.selection-section == section && index >= Grid.selection-from && index <= Grid.selection-to
        ? Ink.selection : transparent;
    // Holds the slots, so it sees the pointer over any of them: edit mode frames the hovered bar.
    hover := TouchArea {
        mouse-cursor: Grid.is-editable ? pointer : default;
    HorizontalLayout {
        if bar.meter != "": Text {
            // A per-bar meter override (F-ED-11), at the start of the bar like a time signature.
            text: bar.meter;
            font-family: ChartFont.family;
            font-size: 0.9 * Size.rem;
            font-weight: 700;
            stroke: self.color;
            stroke-width: ChartFont.bold-stroke;
            color: Ink.ink;
            vertical-alignment: center;
            horizontal-alignment: right;
            min-width: self.preferred-width + 0.4 * Size.rem;
        }
        for slot[i] in bar.slots: Rectangle {
            // Width shared by beats, whatever the chord's length.
            horizontal-stretch: slot.beats;
            min-width: 0;
            preferred-width: 0;
            Slot {
                slot: slot;
                section: section;
                bar: index;
                index: i;
                bar-count: bar-count;
            }
            if i > 0: Dots {
                x: 0;
                width: 1px;
                vertical: true;
                dot: 1px;
                step: 3px;
                dot-color: Ink.hairline;
            }
        }
    }
    }
    // The bar line closing it.
    Rectangle {
        x: parent.width - 2px;
        width: 2px;
        background: Ink.ink;
    }
    // Edit mode affordance: lighter than the cursor's ring.
    if Grid.is-editable && hover.has-hover: Rectangle {
        border-width: 1px;
        border-color: Ink.focus;
    }
}

component Section inherits VerticalLayout {
    in property <SectionView> section;
    in property <int> index;
    in property <int> bars-per-row;
    property <bool> is-current: Grid.cursor-section == index;
    spacing: 0.5 * Size.rem;
    accessible-role: groupbox;
    accessible-label: section.repeat > 1 ? section.label + ", " + section.repeat + " times" : section.label;
    HorizontalLayout {
        alignment: start;
        spacing: 0.5 * Size.rem;
        Rectangle {
            border-width: 2px;
            border-color: Ink.ink;
            background: is-current ? Ink.ink : transparent;
            TouchArea {
                clicked => { Grid.section-clicked(index); }
            }
            ContextMenuArea {
                enabled: Grid.is-editable;
                Menu {
                    MenuItem {
                        title: @tr("Merge with previous section");
                        enabled: index > 0;
                        activated => { Grid.menu(MenuChoice.merge-with-previous, index, 0, 0); }
                    }
                }
            }
            if is-current && Grid.is-drafting-label: DraftInput {
                font-size: Size.rem;
                min-width: 10 * Size.rem;
            }
            HorizontalLayout {
                padding-left: 0.4 * Size.rem;
                padding-right: 0.4 * Size.rem;
                padding-top: 0.05 * Size.rem;
                padding-bottom: 0.05 * Size.rem;
                Text {
                    text: section.label;
                    font-family: ChartFont.family;
                    font-size: Size.rem;
                    font-weight: 700;
                    stroke: self.color;
                    stroke-width: ChartFont.bold-stroke;
                    color: is-current ? Ink.paper : Ink.ink;
                    opacity: is-current && Grid.is-drafting-label ? 0 : 1;
                }
            }
        }
        if section.repeat > 1: Text {
            text: "x" + section.repeat;
            font-family: ChartFont.family;
            font-size: Size.rem;
            font-weight: 700;
            stroke: self.color;
            stroke-width: ChartFont.bold-stroke;
            color: Ink.ink;
            vertical-alignment: center;
        }
    }
    for row[r] in section.rows: Rectangle {
        min-height: 3 * Size.rem;
        // The row's opening bar line; each bar draws its closing one.
        Rectangle {
            x: 0;
            width: 2px;
            background: Ink.ink;
        }
        for bar[i] in row.bars: Bar {
            x: i * parent.width / bars-per-row;
            width: parent.width / bars-per-row;
            bar: bar;
            section: index;
            index: r * bars-per-row + i;
            bar-count: section.bar-count;
        }
        // Bar lines (F-ED-6): a right-click this close to one is on the line, which can split the section or take a bar.
        for i in row.bars.length + 1: ContextMenuArea {
            property <int> after: r * bars-per-row + i;
            x: i * parent.width / bars-per-row - 6px;
            width: 12px;
            enabled: Grid.is-editable;
            Menu {
                MenuItem {
                    title: @tr("Split section here");
                    enabled: after > 0 && after < section.bar-count;
                    activated => { Grid.menu(MenuChoice.split-section-at, index, after, 0); }
                }
                MenuItem {
                    title: @tr("Add empty bar here");
                    activated => { Grid.menu(MenuChoice.add-bar-at, index, after, 0); }
                }
            }
        }
    }
    if section.rows.length == 0: Rectangle {
        min-height: 3 * Size.rem;
        Rectangle {
            x: 0;
            width: 2px;
            background: Ink.ink;
        }
        Rectangle {
            x: parent.width - 2px;
            width: 2px;
            background: Ink.ink;
        }
        if is-current && Grid.has-focus: Rectangle {
            border-width: 3px;
            border-color: Ink.focus;
        }
        Text {
            x: 0.5 * Size.rem;
            text: @tr("No bars yet");
            font-family: ChartFont.family;
            font-size: Size.rem;
            font-italic: true;
            color: Ink.muted;
            vertical-alignment: center;
        }
    }
}

export { Size, ChartFont }

export component Sheet inherits Rectangle {
    in property <ChartView> chart;
    background: Ink.paper;
    border-radius: 8px;
    drop-shadow-blur: 3px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: #00000026;
    accessible-role: table;
    accessible-label: chart.title + " chord chart";
    VerticalLayout {
        padding-top: 2 * Size.rem;
        padding-bottom: 2 * Size.rem;
        padding-left: 1.5 * Size.rem;
        padding-right: 1.5 * Size.rem;
        spacing: 1.75 * Size.rem;
        VerticalLayout {
            Text {
                text: chart.title;
                font-family: ChartFont.family;
                font-size: 2 * Size.rem;
                font-weight: 600;
                stroke: self.color;
                stroke-width: ChartFont.bold-stroke;
                color: Ink.ink;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if chart.artist != "": Text {
                text: chart.artist;
                font-family: ChartFont.family;
                font-size: Size.rem;
                color: Ink.ink;
                horizontal-alignment: center;
            }
            if chart.key != "" || chart.tempo != "": VerticalLayout {
                padding-top: Size.rem;
                if chart.key != "": HorizontalLayout {
                    alignment: start;
                    spacing: 0.3 * Size.rem;
                    Text {
                        text: @tr("Key");
                        font-family: ChartFont.family;
                        font-size: Size.rem;
                        color: Ink.ink;
                    }
                    Text {
                        text: chart.key;
                        font-family: ChartFont.family;
                        font-size: Size.rem;
                        font-weight: 700;
                        stroke: self.color;
                        stroke-width: ChartFont.bold-stroke;
                        color: Ink.ink;
                    }
                }
                // Engraving convention: the tempo marking sits right above the first bar.
                if chart.tempo != "": Text {
                    text: chart.tempo;
                    font-family: ChartFont.family;
                    font-size: Size.rem;
                    color: Ink.ink;
                }
            }
        }
        for section[s] in chart.sections: Section {
            section: section;
            index: s;
            bars-per-row: chart.bars-per-row;
        }
    }
}
