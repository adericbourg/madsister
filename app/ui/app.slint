import { ScrollView, Palette, Button, Switch } from "std-widgets.slint";
import { Sheet, ChartView, Size, Grid } from "sheet.slint";
import { Panels, PanelsView, MetaChoice, Rail } from "panels.slint";
import { Transport, Player } from "transport.slint";
import { StartScreen, Import } from "start.slint";
import { AboutDialog, PreferencesDialog, PreferencesView } from "dialogs.slint";

export { PreferencesView } from "dialogs.slint";

export { Import } from "start.slint";

export { Player } from "transport.slint";

export { PanelsView, MetaChoice } from "panels.slint";

export { ChartView, SectionView, RowView, BarView, SlotView, ChartFont, Grid, MenuChoice } from "sheet.slint";

export struct Shortcut {
    keys: string,
    what: string,
}

/// A tab's label: its song's title, or "New tab" for a start screen.
export struct TabView {
    title: string,
    is-dirty: bool,
}

/// What a menu item asks for.
export enum AppAction { new-tab, open, clear-recent, close-tab, save, save-as, quit, undo, redo, edit-mode, minimize, zoom, preferences, about, sidebar }

/// The dialog open over the window.
export enum Dialog { none, preferences, about }

/// What File ▸ Export writes (F-EX-1..4).
export enum ExportFormat { chord-pro, music-xml, midi, pdf }

/// One tab per open song (F-UI-7); the close buttons sit next to the tabs, not inside them.
component TabBar inherits Rectangle {
    in property <[TabView]> tabs;
    in property <int> active;
    callback selected(int);
    callback closed(int);
    /// The arrow keys: the next tab (1) or the previous one (-1).
    callback cycled(int);
    background: Palette.color-scheme == ColorScheme.dark ? #141416 : #e6e6ea;
    accessible-role: tab-list;
    accessible-label: @tr("Songs");
    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control || event.modifiers.meta || event.modifiers.alt) {
                return reject;
            }
            if (event.text == Key.RightArrow || event.text == Key.LeftArrow) {
                root.cycled(event.text == Key.RightArrow ? 1 : -1);
                // Showing the tab gives the grid the keyboard: the tab bar keeps it.
                self.focus();
                return accept;
            }
            reject
        }
    }
    HorizontalLayout {
        alignment: start;
        padding-left: 0.5 * Size.rem;
        padding-top: 0.25 * Size.rem;
        for item[i] in tabs: Rectangle {
            background: i == active ? Palette.background : transparent;
            border-top-left-radius: 6px;
            border-top-right-radius: 6px;
            border-width: i == active && keys.has-focus ? 2px : 0;
            border-color: Palette.accent-background;
            // The active tab carries the accent on its top edge and its title (F-UI-1).
            if i == active: Rectangle {
                y: 0;
                height: 3px;
                border-top-left-radius: 6px;
                border-top-right-radius: 6px;
                background: Palette.accent-background;
            }
            HorizontalLayout {
                padding-left: 0.75 * Size.rem;
                padding-right: 0.25 * Size.rem;
                padding-top: 0.375 * Size.rem;
                padding-bottom: 0.375 * Size.rem;
                spacing: 0.25 * Size.rem;
                Text {
                    text: (item.is-dirty ? "• " : "") + item.title;
                    max-width: 14 * Size.rem;
                    overflow: elide;
                    vertical-alignment: center;
                    color: i == active ? Palette.accent-background : Palette.foreground;
                    font-weight: i == active ? 600 : 400;
                    accessible-role: tab;
                    accessible-label: item.is-dirty ? @tr("{} (unsaved changes)", item.title) : item.title;
                    accessible-item-selected: i == active;
                    accessible-action-default => { root.selected(i); }
                    TouchArea {
                        clicked => { root.selected(i); }
                    }
                }
                Rectangle {
                    width: 1.25 * Size.rem;
                    height: self.width;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    background: close.has-hover ? Palette.border : transparent;
                    accessible-role: button;
                    accessible-label: @tr("Close {}", item.title);
                    accessible-action-default => { root.closed(i); }
                    Text {
                        text: "×";
                        color: Palette.foreground;
                    }
                    close := TouchArea {
                        clicked => { root.closed(i); }
                    }
                }
            }
        }
    }
}

/// The most frequent actions (F-UI-6); the rest is in the menu.
component Ribbon inherits HorizontalLayout {
    in property <bool> has-song;
    in-out property <bool> is-editing;
    callback action(AppAction);
    callback export-pdf();
    padding: 0.25 * Size.rem;
    padding-left: 0.5 * Size.rem;
    padding-right: 0.5 * Size.rem;
    spacing: 0.5 * Size.rem;
    accessible-role: groupbox;
    accessible-label: @tr("File");
    Button {
        text: @tr("New");
        icon: @image-url("icons/file-plus.svg");
        colorize-icon: true;
        clicked => { root.action(AppAction.new-tab); }
    }
    Button {
        text: @tr("Open…");
        icon: @image-url("icons/folder-open.svg");
        colorize-icon: true;
        clicked => { root.action(AppAction.open); }
    }
    Button {
        text: @tr("Save");
        icon: @image-url("icons/save.svg");
        colorize-icon: true;
        primary: true;
        enabled: has-song;
        clicked => { root.action(AppAction.save); }
    }
    Button {
        text: @tr("Export PDF…");
        icon: @image-url("icons/file-down.svg");
        colorize-icon: true;
        enabled: has-song;
        clicked => { root.export-pdf(); }
    }
    Rectangle { }
    if has-song: HorizontalLayout {
        spacing: 0.5 * Size.rem;
        Text {
            text: @tr("View");
            color: Palette.foreground;
            vertical-alignment: center;
            accessible-role: none;
        }
        Switch {
            text: @tr("Edit");
            accessible-label: @tr("Edit mode");
            // Switching toggles is-editing at once; Rust sets it back to the editor's mode.
            checked <=> root.is-editing;
            toggled => { root.action(AppAction.edit-mode); }
        }
    }
    Button {
        text: @tr("Preferences");
        icon: @image-url("icons/settings.svg");
        colorize-icon: true;
        clicked => { root.action(AppAction.preferences); }
    }
}

export component AppWindow inherits Window {
    // An out property: Rust can't read the inherited title.
    out property <string> window-title: (tabs[active-tab].is-dirty ? "• " : "") + (has-song ? chart.title : "Untitled") + " — madsister";
    title: window-title;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Palette.color-scheme == ColorScheme.dark ? #1c1c1f : #f4f4f6;
    forward-focus: grid-scope;

    /// The recent files' labels, most recent first.
    in property <[string]> recent;
    in property <[TabView]> tabs;
    in property <int> active-tab;
    callback tab-selected(int);
    callback tab-closed(int);
    /// Ctrl+Tab, Ctrl+Shift+Tab, the tab bar's arrow keys: the next tab (1) or the previous one (-1).
    callback tab-cycled(int);
    callback app-action(AppAction);
    /// The menus follow macOS conventions.
    in property <bool> is-mac;
    in-out property <Dialog> dialog;
    /// The settings the Preferences dialog opens with.
    in property <PreferencesView> preferences;
    callback preferences-saved(PreferencesView);
    /// The app's version, for About.
    in property <string> version;
    callback open-url(string);
    /// The sidebar's panels are shown, not just its icon rail (F-UI-4); the Show sidebar menu item checks it.
    in-out property <bool> is-sidebar-shown: true;
    /// A rail button: expand the sidebar on the panel at this index.
    callback panel-shown(int);
    /// The active tab's song is in edit mode; the Edit mode menu item checks it.
    in-out property <bool> is-editing;
    callback export(ExportFormat);
    /// A Nashville song without a key has no notes to export.
    in property <bool> is-export-locked;
    in property <ChartView> chart;
    in property <bool> has-song;
    /// The active tab's last save or open error.
    in property <string> error;
    /// The editor's last notice ("Not possible here"), announced politely.
    in property <string> notice;
    in property <bool> is-help-open;
    in property <[Shortcut]> shortcuts;
    /// The recent file at this index.
    callback open-recent(int);
    /// A key on the grid; true when the editor took it.
    callback grid-key(KeyEvent) -> bool;
    callback close-help();
    in property <PanelsView> panels;
    in property <string> title-error;
    in property <string> key-error;
    in property <string> tempo-error;
    in property <string> section-error;
    /// A question that blocks until answered (deleting a section with chords...), and its yes button.
    in property <string> confirm-text;
    in property <string> confirm-action;
    callback confirm-answered(bool);
    callback meta-committed <=> sidebar.meta-committed;
    callback notation-picked <=> sidebar.notation-picked;
    callback transpose <=> sidebar.transpose;
    callback section-picked <=> sidebar.section-picked;
    callback section-renamed <=> sidebar.section-renamed;
    callback repeat-set <=> sidebar.repeat-set;
    callback section-moved <=> sidebar.section-moved;
    callback section-added <=> sidebar.section-added;
    callback section-deleted <=> sidebar.section-deleted;
    callback bar-beats-set <=> sidebar.bar-beats-set;
    callback shifted <=> sidebar.shifted;
    callback tempo-fixed <=> sidebar.tempo-fixed;

    public function focus-meta(field: MetaChoice) {
        sidebar.focus-meta(field);
    }

    public function focus-bar-beats() {
        sidebar.focus-bar-beats();
    }

    public function focus-grid() {
        grid-scope.focus();
    }

    /// The start screen has no grid: the keyboard waits here, for Ctrl+Tab.
    public function focus-shell() {
        shell.focus();
    }

    public function reveal-panel(index: int) {
        sidebar.reveal-panel(index);
    }

    property <length> scrollbar-width;
    // Handlers, not a binding: a binding would loop through the layout.
    function update-wide() {
        transport.is-wide = self.width - sidebar.width - rail.width > 40rem;
    }
    changed width => { update-wide(); }
    changed is-sidebar-shown => { update-wide(); }

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("New tab");
                shortcut: @keys(Control + N);
                activated => { root.app-action(AppAction.new-tab); }
            }
            MenuItem {
                title: @tr("Open…");
                shortcut: @keys(Control + O);
                activated => { root.app-action(AppAction.open); }
            }
            Menu {
                title: @tr("Open recent");
                enabled: recent.length > 0;
                for label[i] in root.recent: MenuItem {
                    title: label;
                    activated => { root.open-recent(i); }
                }
                MenuSeparator { }
                MenuItem {
                    title: @tr("Clear recent");
                    activated => { root.app-action(AppAction.clear-recent); }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Close tab");
                shortcut: @keys(Control + W);
                enabled: has-song;
                activated => { root.app-action(AppAction.close-tab); }
            }
            MenuItem {
                title: @tr("Save");
                shortcut: @keys(Control + S);
                enabled: has-song;
                activated => { root.app-action(AppAction.save); }
            }
            MenuItem {
                title: @tr("Save as…");
                shortcut: @keys(Control + Shift + S);
                enabled: has-song;
                activated => { root.app-action(AppAction.save-as); }
            }
            MenuSeparator { }
            Menu {
                title: @tr("Export");
                enabled: has-song && !is-export-locked;
                MenuItem {
                    title: @tr("ChordPro…");
                    activated => { root.export(ExportFormat.chord-pro); }
                }
                MenuItem {
                    title: @tr("MusicXML…");
                    activated => { root.export(ExportFormat.music-xml); }
                }
                MenuItem {
                    title: @tr("MIDI…");
                    activated => { root.export(ExportFormat.midi); }
                }
            }
            MenuItem {
                title: @tr("Export PDF…");
                shortcut: @keys(Control + P);
                enabled: has-song;
                activated => { root.export(ExportFormat.pdf); }
            }
            // macOS has Quit in the app menu.
            if !is-mac: MenuSeparator { }
            if !is-mac: MenuItem {
                title: @tr("Quit madsister");
                shortcut: @keys(Control + Q);
                activated => { root.app-action(AppAction.quit); }
            }
        }
        Menu {
            title: @tr("Edit");
            // No shortcut: a menu shortcut would take Ctrl+Z from the text fields' own undo; the grid has its own.
            MenuItem {
                title: @tr("Undo");
                enabled: has-song && is-editing;
                activated => { root.app-action(AppAction.undo); }
            }
            MenuItem {
                title: @tr("Redo");
                enabled: has-song && is-editing;
                activated => { root.app-action(AppAction.redo); }
            }
        }
        Menu {
            title: @tr("View");
            MenuItem {
                title: @tr("Edit mode");
                shortcut: @keys(Control + E);
                enabled: has-song;
                checkable: true;
                // Activating it toggles is-editing at once; Rust sets it back to the editor's mode.
                checked <=> root.is-editing;
                activated => { root.app-action(AppAction.edit-mode); }
            }
            MenuItem {
                title: @tr("Show sidebar");
                enabled: has-song;
                checkable: true;
                checked <=> root.is-sidebar-shown;
                activated => { root.app-action(AppAction.sidebar); }
            }
        }
        Menu {
            title: @tr("Settings");
            MenuItem {
                title: is-mac ? @tr("Settings…") : @tr("Preferences…");
                shortcut: @keys(Control + ",");
                activated => { root.app-action(AppAction.preferences); }
            }
        }
        // On macOS too: Slint's own app menu has no room for it yet.
        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("About madsister");
                activated => { root.app-action(AppAction.about); }
            }
        }
        if is-mac: Menu {
            title: @tr("Window");
            MenuItem {
                title: @tr("Minimize");
                shortcut: @keys(Control + M);
                activated => { root.app-action(AppAction.minimize); }
            }
            MenuItem {
                title: @tr("Zoom");
                activated => { root.app-action(AppAction.zoom); }
            }
        }
    }

    callback create-grid <=> start-screen.create-grid;
    // Ctrl+Tab switches tabs wherever the keyboard is, except in the dialogs (outside this scope). macOS reports Ctrl as meta.
    shell := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if ((event.modifiers.control || event.modifiers.meta) && (event.text == Key.Tab || event.text == Key.Backtab)) {
                root.tab-cycled(event.modifiers.shift || event.text == Key.Backtab ? -1 : 1);
                return accept;
            }
            reject
        }
        VerticalLayout {
            Ribbon {
                has-song: has-song;
                is-editing <=> root.is-editing;
                action(action) => { root.app-action(action); }
                export-pdf => { root.export(ExportFormat.pdf); }
            }
            // Tabs show up with the first song: a lone start screen has none.
            if tabs.length > 1 || has-song: TabBar {
                tabs: tabs;
                active: active-tab;
                selected(i) => { root.tab-selected(i); }
                closed(i) => { root.tab-closed(i); }
                cycled(step) => { root.tab-cycled(step); }
            }
            Text {
                text: error;
                color: Palette.color-scheme == ColorScheme.dark ? #ff8a80 : #b3261e;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                accessible-role: text;
                height: error == "" ? 0 : self.preferred-height + 0.5 * Size.rem;
            }
            Rectangle {
                vertical-stretch: 1;
                start-screen := StartScreen {
                    visible: !has-song;
                }

                HorizontalLayout {
                    visible: has-song;
                    VerticalLayout {
                        HorizontalLayout {
                            alignment: center;
                            padding-left: Size.rem;
                            // The sheet is centered in the scroll's visible width, which leaves the scrollbar out.
                            padding-right: Size.rem + scrollbar-width;
                            padding-top: 0.5 * Size.rem;
                            transport := Transport {
                                // The Sheet's width below.
                                preferred-width: 63 * Size.rem;
                                max-width: 63 * Size.rem;
                                min-width: 0;
                            }
                        }
                        Text {
                            text: notice;
                            color: Palette.foreground;
                            horizontal-alignment: center;
                            accessible-role: text;
                            height: notice == "" ? 0 : self.preferred-height + 0.5 * Size.rem;
                            vertical-alignment: center;
                        }
                        grid-scope := FocusScope {
                            key-pressed(event) => { root.grid-key(event) ? EventResult.accept : EventResult.reject }
                            changed has-focus => { Grid.has-focus = self.has-focus; }
                            scroll := ScrollView {
                                content-width: self.visible-width;
                                content-height: page.preferred-height;
                                // A handler, not a binding: a binding would loop through the layout.
                                changed visible-width => { scrollbar-width = self.width - self.visible-width; }
                                page := VerticalLayout {
                                    width: parent.visible-width;
                                    padding: Size.rem;
                                    alignment: start;
                                    HorizontalLayout {
                                        alignment: center;
                                        Sheet {
                                            // grid.css: max-width 60rem plus its 1.5rem side padding.
                                            preferred-width: 63 * Size.rem;
                                            max-width: 63 * Size.rem;
                                            min-width: 0;
                                            chart: chart;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    rail := Rail {
                        is-collapsed: !is-sidebar-shown;
                        is-editable: Grid.is-editable;
                        toggled => { root.app-action(AppAction.sidebar); }
                        panel-shown(i) => { root.panel-shown(i); }
                    }
                    sidebar := Panels {
                        width: is-sidebar-shown ? 20rem : 0;
                        visible: is-sidebar-shown;
                        view: panels;
                        is-editable: Grid.is-editable;
                        title-error: title-error;
                        key-error: key-error;
                        tempo-error: tempo-error;
                        section-error: section-error;
                    }
                }
            }
        }

    }

    if confirm-text != "": Rectangle {
        background: #00000040;
        TouchArea { }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.confirm-answered(false);
                    return accept;
                }
                reject
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 2rem, 28rem);
                height: question.preferred-height;
                background: Palette.background;
                border-radius: 8px;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000040;
                accessible-role: groupbox;
                accessible-label: confirm-text;
                question := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text {
                        text: confirm-text;
                        wrap: word-wrap;
                        color: Palette.foreground;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Button {
                            text: @tr("Cancel");
                            clicked => { root.confirm-answered(false); }
                        }
                        Button {
                            text: confirm-action;
                            primary: true;
                            clicked => { root.confirm-answered(true); }
                        }
                    }
                }
            }
        }
    }

    if dialog == Dialog.preferences: PreferencesDialog {
        saved: preferences;
        cancelled => {
            root.dialog = Dialog.none;
            root.focus-grid();
        }
        save(view) => { root.preferences-saved(view); }
    }

    if dialog == Dialog.about: AboutDialog {
        version: version;
        cancelled => {
            root.dialog = Dialog.none;
            root.focus-grid();
        }
        open-url(url) => { root.open-url(url); }
    }

    if is-help-open: Rectangle {
        background: #00000040;
        TouchArea { }
        help := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close-help();
                    return accept;
                }
                reject
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 2 * Size.rem, 48 * Size.rem);
                height: min(parent.height - 2 * Size.rem, card.preferred-height);
                background: Palette.background;
                border-radius: 8px;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000040;
                accessible-role: groupbox;
                accessible-label: @tr("Keyboard shortcuts");
                card := VerticalLayout {
                    padding: Size.rem;
                    spacing: 0.75 * Size.rem;
                    Text {
                        text: @tr("Keyboard shortcuts");
                        font-size: 1.25 * Size.rem;
                        font-weight: 600;
                        color: Palette.foreground;
                    }
                    ScrollView {
                        content-height: list.preferred-height;
                        list := VerticalLayout {
                            width: parent.visible-width;
                            spacing: 0.25 * Size.rem;
                            for shortcut in shortcuts: HorizontalLayout {
                                spacing: Size.rem;
                                Text {
                                    text: shortcut.keys;
                                    width: 16 * Size.rem;
                                    font-family: "monospace";
                                    color: Palette.foreground;
                                }
                                Text {
                                    text: shortcut.what;
                                    wrap: word-wrap;
                                    color: Palette.foreground;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        Button {
                            text: @tr("Close");
                            clicked => { root.close-help(); }
                        }
                    }
                }
            }
        }
    }

    // Keeps the cursor slot in view (Grid.reveal, wired in Rust): y is its position in the window.
    public function reveal(y: length, height: length) {
        let top = y - scroll.absolute-position.y;
        if (top < 0) {
            scroll.content-y = min(0, scroll.content-y - top);
        } else if (top + height > scroll.visible-height) {
            scroll.content-y = max(scroll.visible-height - scroll.content-height, scroll.content-y - (top + height - scroll.visible-height));
        }
    }
}
