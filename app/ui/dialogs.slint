// The app's dialogs: Preferences (F-UI-3), About (F-UI-5).

import { Button, CheckBox, ComboBox, SpinBox, Palette } from "std-widgets.slint";

/// The user settings as the Preferences dialog edits them (settings.rs `Settings`, converted in main.rs).
export struct PreferencesView {
    /// 0 French, 1 international, 2 Latin.
    style: int,
    /// Index in settings.rs `ChartFont::ALL`.
    font: int,
    minor-from-tonic: bool,
    bars-per-row: int,
    threshold-percent: int,
    compact-print: bool,
    reopen-tabs: bool,
}

/// A card over the window, closed by Escape; whatever is behind it can't be clicked.
component Modal inherits Rectangle {
    in property <string> title;
    in property <length> card-width: 30rem;
    callback cancelled();
    background: #00000040;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            reject
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 2rem, card-width);
            height: min(parent.height - 2rem, card.preferred-height);
            background: Palette.background;
            border-radius: 8px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            accessible-role: groupbox;
            accessible-label: title;
            card := VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Text {
                    text: title;
                    font-size: 1.25rem;
                    font-weight: 600;
                    color: Palette.foreground;
                }
                @children
            }
        }
    }
}

component Label inherits Text {
    color: Palette.foreground;
}

/// The user settings (F-UI-3), applied on Save; Cancel or Escape discards the edits.
export component PreferencesDialog inherits Modal {
    in property <PreferencesView> saved;
    callback save(PreferencesView);
    title: @tr("Preferences");
    Label { text: @tr("Chord style"); }
    style := ComboBox {
        model: [@tr("French (C7M)"), @tr("International (Cmaj7)"), @tr("Latin (Sol7M)")];
        current-index: saved.style;
        accessible-label: @tr("Chord style");
    }
    Label { text: @tr("Font"); }
    font := ComboBox {
        // ChartFont::ALL's order.
        model: ["Kalam", "Patrick Hand", "Petaluma Script", "Petaluma Text", "Serif"];
        current-index: saved.font;
        accessible-label: @tr("Font");
    }
    Label { text: @tr("Nashville numbers in minor keys"); }
    minor := ComboBox {
        model: [@tr("From the relative major (Am: 6m)"), @tr("From the minor tonic (Am: 1m)")];
        current-index: saved.minor-from-tonic ? 1 : 0;
        accessible-label: @tr("Nashville numbers in minor keys");
    }
    Label { text: @tr("Bars per row"); }
    bars := ComboBox {
        model: ["2", "4", "8"];
        current-index: saved.bars-per-row == 2 ? 0 : saved.bars-per-row == 8 ? 2 : 1;
        accessible-label: @tr("Bars per row");
    }
    Label { text: @tr("Review chords below confidence (%)"); }
    threshold := SpinBox {
        minimum: 0;
        maximum: 100;
        step-size: 5;
        value: saved.threshold-percent;
        accessible-label: @tr("Review chords below confidence (%)");
    }
    compact := CheckBox {
        text: @tr("Compact print (2 columns)");
        checked: saved.compact-print;
    }
    reopen := CheckBox {
        text: @tr("Reopen previous tabs on launch");
        checked: saved.reopen-tabs;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        Button {
            text: @tr("Cancel");
            clicked => { root.cancelled(); }
        }
        Button {
            text: @tr("Save");
            primary: true;
            clicked => {
                root.save({
                    style: style.current-index,
                    font: font.current-index,
                    minor-from-tonic: minor.current-index == 1,
                    bars-per-row: bars.current-index == 0 ? 2 : bars.current-index == 2 ? 8 : 4,
                    threshold-percent: threshold.value,
                    compact-print: compact.checked,
                    reopen-tabs: reopen.checked,
                });
            }
        }
    }
}

/// A link: clicked, or Enter/Space when focused, it asks to open its URL.
component Link inherits FocusScope {
    in property <string> text;
    in property <string> url;
    callback open(string);
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.open(url); }
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == " ") {
            root.open(url);
            return accept;
        }
        reject
    }
    HorizontalLayout {
        Text {
            text: root.text;
            color: Palette.accent-background;
            accessible-role: none;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(url); }
    }
    if root.has-focus: Rectangle {
        border-width: 2px;
        border-radius: 2px;
        border-color: Palette.accent-background;
    }
}

struct Credit {
    name: string,
    url: string,
    by: string,
}

/// A credit: its name links to its project.
component CreditRow inherits HorizontalLayout {
    in property <Credit> credit;
    callback open(string);
    alignment: start;
    spacing: 4px;
    Link {
        text: credit.name;
        url: credit.url;
        open(url) => { root.open(url); }
    }
    Label { text: credit.by; }
}

/// The author, the models' and fonts' credits and licences.
export component AboutDialog inherits Modal {
    in property <string> version;
    callback open-url(string);
    title: @tr("About madsister");
    // Wide enough for the longest credit on one line.
    card-width: 40rem;
    Label { text: @tr("Version {}", version); }
    Label {
        text: @tr("Author");
        font-weight: 600;
    }
    Label { text: "Alban Dericbourg"; }
    Label {
        text: @tr("Models");
        font-weight: 600;
    }
    for credit in [
        { name: "madmom", url: "https://github.com/CPJKU/madmom", by: "by CPJKU, BSD code, weights CC BY-NC-SA 4.0" },
        { name: "all-in-one", url: "https://github.com/mir-aidj/all-in-one", by: "by mir-aidj, MIT" },
        { name: "Demucs", url: "https://github.com/adefossez/demucs", by: "by Meta / Alexandre Défossez, MIT" },
        { name: "BTC", url: "https://github.com/jayg996/BTC-ISMIR19", by: "by jayg996, MIT" },
        { name: "Chord-CNN-LSTM", url: "https://github.com/music-x-lab/ISMIR2019-Large-Vocabulary-Chord-Recognition", by: "by music-x-lab, MIT" },
        ]: CreditRow {
        credit: credit;
        open(url) => { root.open-url(url); }
    }
    Label {
        text: @tr("Fonts");
        font-weight: 600;
    }
    for credit in [
        { name: "Patrick Hand", url: "https://github.com/google/fonts/tree/main/ofl/patrickhand", by: "by Patrick Wagesreiter, SIL Open Font License 1.1" },
        { name: "Kalam", url: "https://github.com/google/fonts/tree/main/ofl/kalam", by: "by Indian Type Foundry, SIL Open Font License 1.1" },
        { name: "Petaluma", url: "https://github.com/steinbergmedia/petaluma", by: "by Steinberg Media Technologies, SIL Open Font License 1.1" },
        ]: CreditRow {
        credit: credit;
        open(url) => { root.open-url(url); }
    }
    Link {
        text: @tr("Source code on GitHub");
        url: "https://github.com/adericbourg/madsister";
        open(url) => { root.open-url(url); }
    }
    HorizontalLayout {
        alignment: end;
        Button {
            text: @tr("Close");
            clicked => { root.cancelled(); }
        }
    }
}
