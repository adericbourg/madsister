{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. Files picked in a dialog are added to the fs scope at runtime by the dialog plugin; the static scope only covers the app config dir and *.madsister.json files anywhere (recent files after a restart, a transcription next to audio on another drive, URL imports and recordings in the app data dir; dot dirs too, see plugins.fs in tauri.conf.json).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:webview:allow-print",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/**" }]
    },
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPCONFIG/*" }, { "path": "/**/*.madsister.json" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPCONFIG/*" }, { "path": "/**/*.madsister.json" }]
    },
    "fs:allow-write-file",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "/**/*.madsister.json" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPCONFIG" }]
    }
  ]
}
